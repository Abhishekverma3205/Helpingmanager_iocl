# Copy this file to .env for local development (never commit the real .env).
# In production, set these as real environment variables on your host/PaaS —
# don't ship a .env file inside a deployed container/image.

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# "production" enables Secure cookies, HSTS, and requires SECRET_KEY.
# Leave unset or "development" for local work.
FLASK_ENV=production

# Optional: where the SQLite file lives. Point this at a persistent
# volume/disk on your host — the default (./instance/dealer.db) will not
# survive an ephemeral filesystem (e.g. most containers without a volume).
DATABASE_PATH=/data/dealer.db

# Optional: set the deployment's own local time zone so daily/shift reports
# line up with the station's clock rather than the server's default (UTC on
# most cloud hosts). Use an IANA name, e.g.:
#   TZ=America/Chicago
#   TZ=Europe/London
#   TZ=Asia/Kolkata
TZ=UTC

# Optional, local/demo only — seeds demo accounts + sample data on a brand
# new, empty database. Never set this in a real production deployment.
# SEED_DEMO_DATA=true

# Optional: the port the app listens on (gunicorn/Flask dev server both
# read this). Most PaaS platforms set this for you automatically.
PORT=8000
